# ── MetaWhats — produção (copie para .env e preencha) ───────────────
NODE_ENV=production
PORT=3001

METAWHATS_ALLOWED_ORIGINS=https://chat.franciscobruno.com
OPENZAP_ALLOWED_ORIGINS=https://chat.franciscobruno.com

# Segredo HMAC (mín. 16 caracteres; gere uma string aleatória forte)
METAWHATS_JWT_SECRET=

TRUST_PROXY_HOPS=1

TURN_ENABLED=1
TURN_PORT=3478
TURN_PUBLIC_HOST=chat.franciscobruno.com
TURN_EXTERNAL_IP=
TURN_USERNAME=metawhats
TURN_PASSWORD=
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535

LETSENCRYPT_DOMAIN=chat.franciscobruno.com
